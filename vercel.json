{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --ignore-scripts || true",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" },
    { "source": "/system/(.*)", "destination": "/api/main.py" },
    { "source": "/dart/(.*)", "destination": "/api/main.py" },
    { "source": "/kind/(.*)", "destination": "/api/main.py" },
    { "source": "/parse/(.*)", "destination": "/api/main.py" },
    { "source": "/classify/(.*)", "destination": "/api/main.py" },
    { "source": "/docs", "destination": "/api/main.py" },
    { "source": "/openapi.json", "destination": "/api/main.py" },
    { "source": "/redoc", "destination": "/api/main.py" }
  ],
  "functions": {
    "api/main.py": {
      "runtime": "python3.12",
      "maxDuration": 60
    }
  }
}
